{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "invit-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "invit-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port=4173"
      ],
      "port": 4173,
      "url": "http://localhost:4173"
    },
    {
      "name": "wp-local",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd wp-local && PHP_CLI_SERVER_WORKERS=5 php -d error_reporting=0 -d memory_limit=512M -S localhost:8099 -t ."
      ],
      "port": 8099
    }
  ]
}
